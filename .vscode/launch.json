{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build, serve and debug site",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/serve.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build site",
      "env": {
        "PORT": "5502"
      },
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "serverReadyAction": {
        "pattern": "Serving built site at (http://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithEdge",
        "webRoot": "${workspaceFolder}/dist"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
